<!DOCTYPE html>
<html>
<head>
    <title>Notes App</title>
</head>
<body>

    <form action="/notes" method="POST">
        <input type="text" name="title" placeholder="Enter note">
        <input type="text" name="desc" placeholder="Enter note">
        <button type="submit">Add Note</button>
    </form>

    <h2>Notes</h2>

    <% notes.forEach((note, index) => { %>
        <ul>
            <li><%= note.title %></li>
            <li><%= note.desc %></li>
            <li><a href="/notes/<%= index %>">Delete</a></li>
        </ul>
    <% }) %>

</body>
</html>